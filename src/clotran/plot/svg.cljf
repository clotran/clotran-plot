(ns clotran.plot.svg
  "A scene (clotran.plot/graph's or /surface's) as SVG text in the look of
  a theme (clotran.plot.theme): its marks (clotran.plot.marks), each one
  SVG element."
  (:require [clojure.string :as str]
            [clotran.plot.marks :as marks]
            [clotran.plot.theme :as theme]))

(def labels marks/labels)

(defn- n2 [x] (format "%.2f" (double x)))

(defn- esc
  "s for SVG text or an attribute: & < > \" escaped, and every character
  past ASCII as a character reference (U+2212 as &#x2212;)."
  [s]
  (apply str (map #(let [c (int %)]
                     (case %
                       \& "&amp;" \< "&lt;" \> "&gt;" \" "&quot;"
                       (if (< c 128) (str %) (format "&#x%x;" c))))
                  s)))

(defn- stroke
  "The stroke attributes for colour c, width w (1, SVG's default, unsaid)."
  [c w]
  (str "stroke=\"" (esc c) "\"" (when (not= w 1) (str " stroke-width=\"" w "\""))))

(defn- pts [ps] (str/join " " (map (fn [[x y]] (str (n2 x) "," (n2 y))) ps)))

(defn element
  "One mark as one SVG element."
  [{:keys [op] :as m}]
  (case op
    :ground (str "<rect width=\"" (:w m) "\" height=\"" (:h m) "\" fill=\"" (esc (:fill m)) "\"/>")
    :line (str "<line x1=\"" (n2 (:x1 m)) "\" y1=\"" (n2 (:y1 m)) "\" x2=\"" (n2 (:x2 m)) "\" y2=\"" (n2 (:y2 m)) "\" "
               (stroke (:colour m) (:width m))
               (when-let [o (:opacity m)] (str " stroke-opacity=\"" o "\"")) "/>")
    :text (str "<text x=\"" (n2 (:x m)) "\" y=\"" (n2 (:y m)) "\" text-anchor=\"" (:anchor m) "\""
               (when (:italic m) " font-style=\"italic\"") ">" (esc (:text m)) "</text>")
    :rect (if (:i m)
            (str "<rect data-i=\"" (:i m) "\" data-j=\"" (:j m) "\" x=\"" (n2 (:x m)) "\" y=\"" (n2 (:y m))
                 "\" width=\"" (n2 (:w m)) "\" height=\"" (n2 (:h m))
                 "\" fill=\"" (:fill m) "\" shape-rendering=\"crispEdges\"/>")
            (str "<rect x=\"" (:x m) "\" y=\"" (:y m) "\" width=\"" (:w m) "\" height=\"" (:h m)
                 "\" fill=\"" (esc (:fill m)) "\" " (stroke (:colour m) (:width m)) "/>"))
    :polygon (if (:i m)
               (str "<polygon data-i=\"" (:i m) "\" data-j=\"" (:j m) "\" points=\"" (pts (:points m)) "\" fill=\""
                    (:fill m) "\" "
                    (let [ms (:mesh m)]
                      (if (= :none ms) "stroke=\"none\""
                          (str "stroke=\"" (esc (:colour ms)) "\" stroke-width=\"0.5\" stroke-opacity=\"" (:opacity ms) "\"")))
                    " stroke-linejoin=\"round\"/>")
               (str "<polygon points=\"" (pts (:points m)) "\" fill=\"" (esc (:fill m)) "\"/>"))
    :polyline (str "<polyline fill=\"none\" stroke=\"" (esc (:colour m)) "\" stroke-width=\"" (:width m)
                   "\" stroke-linejoin=\"round\" points=\"" (pts (:points m)) "\"/>")))

(defn svg
  "The scene as an SVG document, a string, in the look of its :theme --
  a keyword, a path or a map, as clotran.plot.theme reads them; when it
  has none, clotran.plot.theme/default."
  [scene]
  (let [{:keys [label-colour font font-size] :as th} (theme/theme (or (:theme scene) (theme/default)))
        [W H] (:size scene)]
    (str/join
     "\n"
     (concat
      [(str "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" W "\" height=\"" H
            "\" viewBox=\"0 0 " W " " H "\" font-family=\"" (esc font) "\" font-size=\"" font-size "\""
            (when (not= label-colour "black") (str " fill=\"" (esc label-colour) "\"")) ">")]
      (map element (marks/marks scene th))
      ["</svg>" ""]))))

(ns clotran.plot.svg
  "A scene (clotran.plot/graph's) as SVG text in one of two themes (see
  themes): axes, ticks and their labels, and each curve as polylines
  clipped to the plot box, broken where the curve is."
  (:require [clojure.math :as m]
            [clojure.string :as str]))

(defn- decimals
  "The fewest decimals, at most 12, that show every tick exactly."
  [ts]
  (or (first (filter (fn [d] (every? #(let [v (* % (m/pow 10 d))]
                                        (< (abs (- v (m/rint v))) (* 1e-6 (max 1 (abs v)))))
                                     ts))
                     (range 13)))
      12))

(defn labels
  "Tick values as labels with the ticks' common decimals: 0.30000000000000004
  among 0.1 steps is \"0.3\", and -0.0 or -1e-17 is \"0\". Each tick is
  rounded to those decimals before format sees it, and a trailing dot
  dropped: clotran formats %.0f as Fortran's F edit does, 10.0 as \"10.\"."
  [ts]
  (let [d (decimals ts) p (m/pow 10 d)]
    (mapv #(let [r (/ (m/rint (* % p)) p)]
             (str/replace (format (str "%." d "f") (if (zero? r) 0.0 r)) #"\.$" ""))
          ts)))

(defn- clip
  "The part of the line p q inside the box [x0 y0 x1 y1], or nil
  (Liang and Barsky, 1984)."
  [[px py] [qx qy] [x0 y0 x1 y1]]
  (let [dx (- qx px) dy (- qy py)
        [t0 t1] (reduce (fn [[t0 t1 :as t] [p q]]
                          (cond (nil? t) nil
                                (zero? p) (when (>= q 0) t)
                                :else (let [r (/ q p)]
                                        (if (neg? p)
                                          (when (<= r t1) [(max t0 r) t1])
                                          (when (>= r t0) [t0 (min t1 r)])))))
                        [0.0 1.0]
                        [[(- dx) (- px x0)] [dx (- x1 px)] [(- dy) (- py y0)] [dy (- y1 py)]])]
    (when t0
      [[(+ px (* t0 dx)) (+ py (* t0 dy))] [(+ px (* t1 dx)) (+ py (* t1 dy))]])))

(defn- runs
  "A polyline in pixels clipped to box: the visible runs of points."
  [pts box]
  (let [[rs r] (reduce (fn [[rs r] [p q]]
                         (if-let [[a b] (clip p q box)]
                           (if (= (peek r) a) [rs (conj r b)] [(cond-> rs (seq r) (conj r)) [a b]])
                           [(cond-> rs (seq r) (conj r)) []]))
                       [[] []] (partition 2 1 pts))]
    (cond-> rs (seq r) (conj r))))

(defn- n2 [x] (format "%.2f" (double x)))

(def themes
  "The looks a scene's :theme picks. :dark, for screens, is inspired by
  Manim's look: a near-black ground, axes through the origin with arrow
  heads, a faint blue grid, Manim's colours, serif labels with true
  minus signs. :light, for papers: a white ground, a frame, labels on
  its left and bottom."
  {:light {:background "white" :ink "black" :font "sans-serif" :font-size 12
           :stroke 1.5 :colours ["#1f6fb4" "#d1495b" "#2e933c" "#8c5fbf" "#e08a1e" "#3a3a3a"]}
   :dark {:background "#0f0f12" :ink "#d9d9d9" :grid "#29ABCA"
          :font "CMU Serif, Latin Modern Math, Cambria Math, Georgia, serif" :font-size 14
          :stroke 2 ; 3 px at 900 wide
          :colours ["#58C4DD" "#FFFF00" "#83C167" "#FC6255" "#5CD0B3" "#9A72AC" "#FF862F"]}})

(defn- line [x1 y1 x2 y2 attrs]
  (str "<line x1=\"" (n2 x1) "\" y1=\"" (n2 y1) "\" x2=\"" (n2 x2) "\" y2=\"" (n2 y2) "\" " attrs "/>"))

(defn- text [x y anchor s]
  (str "<text x=\"" (n2 x) "\" y=\"" (n2 y) "\" text-anchor=\"" anchor "\">" s "</text>"))

(defn- light-axes
  "The frame, ticks and labels outside it, and grey zero lines."
  [{:keys [box x-range y-range x-ticks y-ticks]} px py]
  (let [[bx by bw bh] box [xa xb] x-range [ya yb] y-range]
    (concat
     (when (< xa 0 xb) [(line (px 0) by (px 0) (+ by bh) "stroke=\"#bbb\"")])
     (when (< ya 0 yb) [(line bx (py 0) (+ bx bw) (py 0) "stroke=\"#bbb\"")])
     (mapcat (fn [t s] [(line (px t) (+ by bh) (px t) (+ by bh 5) "stroke=\"black\"")
                        (text (px t) (+ by bh 18) "middle" s)])
             x-ticks (labels x-ticks))
     (mapcat (fn [t s] [(line (- bx 5) (py t) bx (py t) "stroke=\"black\"")
                        (text (- bx 8) (+ (py t) 4) "end" s)])
             y-ticks (labels y-ticks))
     [(str "<rect x=\"" bx "\" y=\"" by "\" width=\"" bw "\" height=\"" bh "\" fill=\"none\" stroke=\"black\"/>")])))

(defn- dark-axes
  "A grid at the ticks; the axes through the origin, or along the edge
  nearer it when 0 is outside a range, each with an arrow head at its
  positive end and ticks across it; labels beside them with U+2212 for
  minus. A 0 label is left out where the other axis runs through it."
  [{:keys [box x-range y-range x-ticks y-ticks]} px py {:keys [grid ink]}]
  (let [[bx by bw bh] box [xa xb] x-range [ya yb] y-range
        clamp (fn [v a b] (max a (min b v)))
        ax (px (clamp 0.0 xa xb)) ay (py (clamp 0.0 ya yb))
        minus #(str/replace % "-" "&#x2212;")
        stroke (str "stroke=\"" ink "\" stroke-width=\"1.5\"")
        right (+ bx bw 10) top (- by 10)]
    (concat
     (for [t x-ticks] (line (px t) by (px t) (+ by bh) (str "stroke=\"" grid "\" stroke-opacity=\"0.35\"")))
     (for [t y-ticks] (line bx (py t) (+ bx bw) (py t) (str "stroke=\"" grid "\" stroke-opacity=\"0.35\"")))
     [(line bx ay (- right 6) ay stroke)
      (str "<polygon points=\"" (n2 right) "," (n2 ay) " " (n2 (- right 10)) "," (n2 (- ay 4)) " "
           (n2 (- right 10)) "," (n2 (+ ay 4)) "\" fill=\"" ink "\"/>")
      (line ax (+ by bh) ax (+ top 6) stroke)
      (str "<polygon points=\"" (n2 ax) "," (n2 top) " " (n2 (- ax 4)) "," (n2 (+ top 10)) " "
           (n2 (+ ax 4)) "," (n2 (+ top 10)) "\" fill=\"" ink "\"/>")]
     (mapcat (fn [t s] (cons (line (px t) (- ay 4) (px t) (+ ay 4) stroke)
                             (when-not (and (zero? t) (< ya 0) (<= xa 0 xb))
                               [(text (px t) (+ ay 20) "middle" (minus s))])))
             x-ticks (labels x-ticks))
     (mapcat (fn [t s] (cons (line (- ax 4) (py t) (+ ax 4) (py t) stroke)
                             (when-not (and (zero? t) (< xa 0) (<= ya 0 yb))
                               [(text (- ax 8) (+ (py t) 5) "end" (minus s))])))
             y-ticks (labels y-ticks)))))

(defn svg
  "The scene as an SVG document, a string, in the look of its :theme
  (:dark by default; see themes). Curve i is drawn in the theme's
  colour i, in turn."
  [{:keys [size box x-range y-range curves theme] :or {theme :dark} :as scene}]
  (let [{:keys [background ink font font-size stroke colours] :as th} (themes theme)
        [W H] size
        [bx by bw bh] box
        [xa xb] x-range [ya yb] y-range
        px #(+ bx (* (- % xa) (/ bw (- xb xa))))
        py #(- (+ by bh) (* (- % ya) (/ bh (- yb ya))))
        clipbox [bx by (+ bx bw) (+ by bh)]]
    (str/join
     "\n"
     (concat
      [(str "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" W "\" height=\"" H
            "\" viewBox=\"0 0 " W " " H "\" font-family=\"" font "\" font-size=\"" font-size "\""
            (when (not= ink "black") (str " fill=\"" ink "\"")) ">")
       (str "<rect width=\"" W "\" height=\"" H "\" fill=\"" background "\"/>")]
      (if (= theme :light) (light-axes scene px py) (dark-axes scene px py th))
      (for [[i {:keys [segments]}] (map-indexed vector curves)
            seg segments
            r (runs (map (fn [[x y]] [(px x) (py y)]) seg) clipbox)]
        (str "<polyline fill=\"none\" stroke=\"" (colours (mod i (count colours)))
             "\" stroke-width=\"" stroke "\" stroke-linejoin=\"round\" points=\""
             (str/join " " (map (fn [[x y]] (str (n2 x) "," (n2 y))) r)) "\"/>"))
      ["</svg>" ""]))))

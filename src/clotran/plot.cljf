(ns clotran.plot
  "Graphs that pick their picture from the data (PLAN.md). Today:
  functions of x, as curves, and functions of x and y, as surfaces or
  heat maps, to a scene and to SVG."
  (:require [clotran.plot.sample :as sample]
            [clotran.plot.surface :as surface]
            [clotran.plot.svg :as svg]
            [clotran.plot.ticks :as ticks]))

(def size "The picture, [width height] in pixels." [600 400])
(def box "The plot box inside it, [x y width height]." [60 20 520 340])

(defn graph
  "The scene for the curve of f, a function of one double, or of each
  function in a vector of them, over xmin..xmax (-10..10 by default, a
  TI-85's ZStandard): plain data, {:size :box :x-range :y-range :x-ticks
  :y-ticks :curves [{:segments} ..]}, each segment a polyline [[x y] ..]
  in data units. Each curve is sampled by clotran.plot.sample, and the y
  range is its, or for several the union of theirs rounded out to new
  ticks; the x range is as given, with extended-Wilkinson ticks inside
  it."
  ([f] (graph f -10 10))
  ([f xmin xmax]
   (let [[a b] (map double (sort [xmin xmax]))
         [_ _ w h] box
         ss (mapv #(sample/sample % a b {:w w :h h}) (if (vector? f) f [f]))
         y-ticks (if (= 1 (count ss))
                   (:y-ticks (first ss))
                   (ticks/extended (apply min (map (comp first :y-range) ss))
                                   (apply max (map (comp second :y-range) ss))
                                   5 {:only-loose true}))]
     {:size size :box box
      :x-range [a b]
      :x-ticks (filterv #(<= a % b) (ticks/extended a b 5))
      :y-range [(first y-ticks) (peek y-ticks)] :y-ticks y-ticks
      :curves (mapv #(hash-map :segments (:segments %)) ss)})))

(defn graph-svg
  "The graph of f (or of a vector of functions) written to path as SVG;
  returns path. Options: :x [xmin xmax] (-10..10); :theme, a built-in's
  keyword (:dark, for screens, or :light, for papers), the path of an
  .edn file or a map, as clotran.plot.theme reads them -- by default
  the project's plot-theme.edn if it has one, else :dark."
  [f path & {:keys [x theme] :or {x [-10 10]}}]
  (spit path (svg/svg (cond-> (graph f (x 0) (x 1)) theme (assoc :theme theme))))
  path)

(defn surface
  "The scene for z = f(x, y), f a function of two doubles: a surface in
  3D, or with :view :heat a heat map. Options: :x and :y ranges [a b],
  :n cells a side, :view, :azimuth and :elevation; see
  clotran.plot.surface."
  [f & opts]
  (apply surface/surface f opts))

(defn surface-svg
  "The surface of f written to path as SVG (600 by 500; a heat map 600
  by 400); returns path. Options: those of surface, and :theme as for
  graph-svg."
  [f path & {:keys [theme] :as opts}]
  (spit path (svg/svg (cond-> (apply surface/surface f (mapcat identity (dissoc opts :theme)))
                        theme (assoc :theme theme))))
  path)

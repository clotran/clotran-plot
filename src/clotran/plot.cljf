(ns clotran.plot
  "Graphs that pick their picture from the data (PLAN.md). Today:
  functions of x, as curves, and functions of x and y, as surfaces or
  heat maps, to a scene and to SVG."
  (:require [clojure.string :as str]
            [clotran.plot.sample :as sample]
            [clotran.plot.surface :as surface]
            [clotran.plot.svg :as svg]
            [clotran.plot.ticks :as ticks]))

(def size "The picture, [width height] in pixels." [600 400])
(def box "The plot box inside it, [x y width height]." [60 20 520 340])

(defn graph
  "The scene for the curve of f, a function of one double, or of each
  function in a vector of them, over xmin..xmax (-10..10 by default, a
  TI-85's ZStandard): plain data, {:size :box :x-range :y-range :x-ticks
  :y-ticks :curves [{:segments} ..]}, each segment a polyline [[x y] ..]
  in data units. Each curve is sampled by clotran.plot.sample, and the y
  range is its, or for several the union of theirs rounded out to new
  ticks; the x range is as given, with extended-Wilkinson ticks inside
  it. Options, a map: :size [width height] in pixels (600 by 400; the
  box keeps its margins), :y [ymin ymax], a y range to draw in instead
  of the curves' own -- a zoom -- and :x-ticks and :y-ticks, the ticks to
  draw instead of chosen ones, as data -- (clotran.plot.ticks/extended a b
  10), say, or [-1 0 1] -- those inside the range kept."
  ([f] (graph f -10 10))
  ([f xmin xmax] (graph f xmin xmax {}))
  ([f xmin xmax {y :y sz :size xt :x-ticks yt :y-ticks :or {sz size}}]
   (let [[W H] sz
         [a b] (map double (sort [xmin xmax]))
         box (if (= [W H] size) box [60 20 (- W 80) (- H 60)])
         [_ _ w h] box
         ss (mapv #(sample/sample % a b (cond-> {:w w :h h} y (assoc :y y))) (if (vector? f) f [f]))
         y-ticks (if (or y (= 1 (count ss)))
                   (:y-ticks (first ss))
                   (ticks/extended (apply min (map (comp first :y-range) ss))
                                   (apply max (map (comp second :y-range) ss))
                                   5 {:only-loose true}))]
     (let [[c d :as y-range] (if y (:y-range (first ss)) [(first y-ticks) (peek y-ticks)])
           within (fn [lo hi ts] (filterv #(<= lo % hi) (map double ts)))]
       {:size [W H] :box box
        :x-range [a b]
        :x-ticks (within a b (or xt (ticks/extended a b 5)))
        :y-range y-range :y-ticks (if yt (within c d yt) y-ticks)
        :curves (mapv #(hash-map :segments (:segments %)) ss)}))))

(defn- check-plot!
  "plot's arguments, refused before any window opens, in words a person
  can act on: f each a function of x answering a number at x = 1, opts
  keyword and value pairs."
  [f opts]
  (let [hint "for y = x write (plot/plot (fn [x] x))"]
    (when-not (and (even? (count opts)) (every? keyword? (take-nth 2 opts)))
      (throw (ex-info (str "plot/plot takes a function, then options as :x [-10 10] :y [-1 1] :title \"..\"; got "
                           (str/join " " (map pr-str opts))) {:opts opts})))
    (doseq [g (let [v (if (or (fn? f) (vector? f)) f (try (deref f) (catch :default _ f)))] (if (vector? v) v [v]))]
      (when-not (fn? g)
        (throw (ex-info (str "plot/plot graphs a function of x, not " (pr-str g) " -- " hint) {:f g})))
      (let [y (try (g 1.0)
                   (catch :default e
                     (throw (ex-info (str "the function threw at x = 1: " (or (ex-message e) (str e)) " -- " hint) {:f g}))))]
        (when-not (number? y)
          (throw (ex-info (str "the function gives " (pr-str y) " at x = 1, not a number -- " hint) {:f g})))))))

(defn plot
  "f graphed in a window, with trace and zoom (clotran.plot.window/show,
  whose options it takes): f a function of x, a vector of them, or an
  atom holding either, redrawn when it changes. A function that is not
  one of x is refused before a window opens. Loads clotran-ui, and
  builds its native half the first time, only when called."
  [f & opts]
  (check-plot! f opts)
  (require 'clotran.plot.window)
  (apply (resolve 'clotran.plot.window/show) f opts))

(defn plot3d
  "The surface z = f(x, y) in a window, in 3D on the GPU: drag to turn it,
  scroll to zoom (clotran.plot.window/show3d, whose options it takes)."
  [f & opts]
  (require 'clotran.plot.window)
  (apply (resolve 'clotran.plot.window/show3d) f opts))

(defn graph-svg
  "The graph of f (or of a vector of functions) written to path as SVG;
  returns path. Options: :x [xmin xmax] (-10..10); :theme, a built-in's
  keyword (:dark, for screens, or :light, for papers), the path of an
  .edn file or a map, as clotran.plot.theme reads them -- by default
  the project's plot-theme.edn if it has one, else :dark; :x-ticks and
  :y-ticks as graph's."
  [f path & {:keys [x theme] :or {x [-10 10]} :as opts}]
  (spit path (svg/svg (cond-> (graph f (x 0) (x 1) (select-keys opts [:x-ticks :y-ticks])) theme (assoc :theme theme))))
  path)

(defn surface
  "The scene for z = f(x, y), f a function of two doubles: a surface in
  3D, or with :view :heat a heat map. Options: :x and :y ranges [a b],
  :n cells a side, :view, :azimuth and :elevation; see
  clotran.plot.surface."
  [f & opts]
  (apply surface/surface f opts))

(defn surface-svg
  "The surface of f written to path as SVG (600 by 500; a heat map 600
  by 400); returns path. Options: those of surface, and :theme as for
  graph-svg."
  [f path & {:keys [theme] :as opts}]
  (spit path (svg/svg (cond-> (apply surface/surface f (mapcat identity (dissoc opts :theme)))
                        theme (assoc :theme theme))))
  path)

;; clotran-plot: graphs for clotran -- in a clotran-ui window, or to
;; SVG and PNG with no window system. Provided libraries
;; (org.clojure/clojure) are clotran itself; see clotran's PACKAGES.md.
;; clotran-ui is loaded only when a window is asked for (clotran.plot/show).
{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        clotran/clotran-ui {:git/url "https://github.com/clotran/clotran-ui"
                            :git/sha "f22ba04923ad6635d749e32eb8c0dbb2518db15d"}}}

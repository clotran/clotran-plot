;; test/window_check.cljf: clotran's half of test/window_check.bb -- opens
;; real windows, drives them with injected events as a person would, and
;; prints what happened as EDN lines for the bb script to judge.
(require '[clotran.plot :as plot] '[clotran.plot.marks :as marks]
         '[clotran.ui :as ui] '[clojure.math :as m])

(def out (first *command-line-args*))
(def windows? (clojure.string/starts-with? (str (clotran.host.system/getProperty "os.name")) "Windows"))
(defn img
  "A picture's path: PNG on macOS, BMP on Windows (written with no image library)."
  [name] (str out "/" name (if windows? ".bmp" ".png")))
(defn rec
  "A result: printed, and kept in out/results.edn for a judge elsewhere."
  [v] (prn v) (spit (str out "/results.edn") (str (pr-str v) "\n") :append true))
(spit (str out "/results.edn") "")

(defn settle
  "Waits until (pred) or 10 s; answers (pred)'s last value."
  [pred]
  (loop [t 0]
    (let [v (pred)]
      (if (or v (> t 10000)) v (do (clotran.host.thread/sleep 50) (recur (+ t 50)))))))

(defn near [[a b] [c d]] (and a c (< (abs (- a c)) 0.05) (< (abs (- b d)) 0.05)))

(defn px-of [st x y] (let [[px py] (marks/pixels (:scene @st))] [(px x) (py y)]))

(def st (plot/plot m/sin))
(settle #(:scene @st))
(def w (:win @st))
(rec [:opened w (ui/open-count)])
(settle #(= (:size (:scene @st)) (mapv long (ui/area-size w))))
(rec [:sizes-sin (:size (:scene @st)) (ui/area-size w)])
(rec [:capture (ui/capture w (img "window-sin"))])
(rec [:snapshot (ui/snapshot w 600 400 (img "snapshot-sin")) (:box (:scene @st)) (:x-range (:scene @st)) (:y-range (:scene @st))])

;; trace: the mouse at x = 1.3 on the curve
(let [[mx my] (px-of st 1.3 (m/sin 1.3))]
  (ui/inject! w {:type :move :x mx :y my :held 0})
  (rec [:trace mx my (settle #(:trace @st))])
  (clotran.host.thread/sleep 300)
  (ui/capture w (img "window-trace")))

;; zoom: a box dragged from (-2, 0.5) to (3, -0.5)
(let [[x0 y0] (px-of st -2 0.5) [x1 y1] (px-of st 3 -0.5)]
  (ui/inject! w {:type :down :x x0 :y y0 :button 1 :count 1})
  (ui/inject! w {:type :move :x x1 :y y1 :held 1})
  (clotran.host.thread/sleep 500)
  (ui/capture w (img "window-zoom-box"))
  (ui/inject! w {:type :up :x x1 :y y1 :button 1 :count 1})
  (settle #(near [-2.0 3.0] (:x-range (:scene @st))))
  (rec [:zoom [x0 y0 x1 y1] (:x @st) (:y @st) (:x-range (:scene @st)) (:y-range (:scene @st))]))
(ui/capture w (img "window-zoomed"))

;; + zooms in about the middle, Escape goes back, twice to the start
(ui/inject! w {:type :key :char \+})
(settle #(near [-0.75 1.75] (:x-range (:scene @st))))
(rec [:plus (:x-range (:scene @st)) (:y-range (:scene @st))])
(ui/inject! w {:type :key :key :escape})
(ui/inject! w {:type :key :key :escape})
(settle #(= [-10.0 10.0] (:x-range (:scene @st))))
(rec [:back (:x-range (:scene @st)) (:y-range (:scene @st))])

;; resize
(ui/inject! w {:type :resize :width 800 :height 500})
(settle #(= [800 500] (:size (:scene @st))))
(rec [:resize (:size (:scene @st)) (:box (:scene @st))])
;; one graph window: the next graph draws in this one, and a thing that
;; is not a function of x is refused before any window is touched
(def st-b (plot/plot (fn [x] (* x x)) :y-ticks [0 50 100]))
(rec [:reused (identical? st st-b) (ui/open-count) (count (:curves (:scene @st-b))) (:y-ticks (:scene @st-b))])
(rec [:refused (try (plot/plot #(%)) :not-refused
                    (catch :default e (boolean (re-find #"at x = 1" (str (ex-message e))))))
      (ui/open-count)])
(ui/close! w)

;; live: a graph of an atom redraws when it changes
(def a (atom m/sin))
(def st2 (plot/plot a :title "live"))
(settle #(:scene @st2))
(defn first-pt [] (first (first (:segments (first (:curves (:scene @st2)))))))
(rec [:live-before (first-pt)])
(reset! a m/cos)
(settle #(not= (m/sin -10.0) (second (first-pt))))
(rec [:live-after (first-pt)])
(ui/close! (:win @st2))

;; several at once
(def st3 (plot/plot [m/sin m/cos #(/ % 4)] :title "three"))
(settle #(:scene @st3))
(settle #(= (:size (:scene @st3)) (mapv long (ui/area-size (:win @st3)))))
(rec [:sizes-three (:size (:scene @st3)) (ui/area-size (:win @st3))])
(rec [:three (count (:curves (:scene @st3))) (ui/capture (:win @st3) (img "window-three"))])
(ui/close! (:win @st3))

;; the calculator: typing (the field set, its change event injected)
(require '[clotran.plot.calc :as calc])
(def c (calc/run))
(settle #(:scene @c))
(settle #(= (:size (:scene @c)) (mapv long (ui/area-size (:win @c)))))
(defn type! [s] (ui/set-text! (:win @c) :entry s) (ui/inject! (:win @c) {:type :text}))
(type! "(* x x)")
(settle #(= [0.0 100.0] (:y-range (:scene @c))))
(clotran.host.thread/sleep 300)
(rec [:calc-square (:y-range (:scene @c)) (ui/capture (:win @c) (img "calc-square"))])
(type! "(* x")
(clotran.host.thread/sleep 1000)
(rec [:calc-unfinished (:y-range (:scene @c)) (ui/capture (:win @c) (img "calc-unfinished"))])
(type! "(sin x) (/ x 4)")
(settle #(= 2 (count (:curves (:scene @c)))))
(clotran.host.thread/sleep 300)
(rec [:calc-two (count (:curves (:scene @c))) (ui/capture (:win @c) (img "calc-two"))])
(rec [:sizes-calc (:size (:scene @c)) (ui/area-size (:win @c))])
(ui/close! (:win @c))

;; 3D on the GPU: a ripple, drawn offscreen and as shown, turned by a
;; drag of (+80, -40) px -- half a degree a pixel -- and zoomed by a scroll
(def s3 (plot/plot3d (fn [x y] (m/sin (m/sqrt (+ (* x x) (* y y)))))))
(def w3 (:win @s3))
(clotran.host.thread/sleep 1000)
(rec [:gpu-view (ui/camera w3) (ui/snapshot3d w3 700 560 (img "gpu-ripple")) (ui/capture w3 (img "gpu-shown"))])
(ui/inject! w3 {:type :down :x 300 :y 300 :button 1 :count 1})
(ui/inject! w3 {:type :move :x 380 :y 260 :held 1})
(ui/inject! w3 {:type :up :x 380 :y 260 :button 1 :count 1})
(ui/inject! w3 {:type :scroll :dy -5})
(settle #(not= 28.0 (:elevation (ui/camera w3))))
(clotran.host.thread/sleep 300)
(rec [:gpu-turned (ui/camera w3) (ui/snapshot3d w3 700 560 (img "gpu-ripple-turned"))])
(ui/close! w3)
(rec [:closed (ui/open-count)])
